# ---------------------------------------------------------------------------
# Maintenance Monitor Web — environment configuration
# Copy to .env.local for development. Every NEXT_PUBLIC_* value is embedded in
# the browser bundle at build time: never put secrets here.
# ---------------------------------------------------------------------------

# Base URL of the Maintenance Monitor REST API, including the version prefix.
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Origin of the Socket.IO server that hosts the /status-board namespace.
# Usually the API origin without a path.
NEXT_PUBLIC_WS_URL=http://localhost:3000
